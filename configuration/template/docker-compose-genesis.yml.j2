services:
  scylla:
    image: scylladb/scylla:6.1.3
    security_opt:
      - seccomp:unconfined
    container_name: {{ validator.scylla_name }}
    volumes:
      - {{ validator.scylla_volume }}:/var/lib/scylla
    environment:
      SCYLLA_AUTO_CONF: 1
    command:
      - "--developer-mode"
      - "1"
      - "--overprovisioned"
      - "1"
      - "--memory"
      - "4G"
      - "--smp"
      - "2"

  proxy:
    image: "${LINERA_IMAGE:-linera}"
    container_name: {{ validator.validator_name }}
    ports:
      - "{{ validator.validator_port }}:{{ validator.validator_port }}"
    command: [ "./compose-proxy-entrypoint.sh" ]
    volumes:
      - {{ validator.validator_persistence_dir }}:/config
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    depends_on:
      shard-init:
        condition: service_completed_successfully

  shard:
    image: "${LINERA_IMAGE:-linera}"
    deploy:
      replicas: 4
    command: [ "./compose-server-entrypoint.sh" ]
    volumes:
      - {{ validator.validator_persistence_dir }}:/config
    labels:
      com.centurylinklabs.watchtower.enable: "true"
    depends_on:
      shard-init:
        condition: service_completed_successfully

  shard-init:
    image: "${LINERA_IMAGE:-linera}"
    container_name: {{ validator.shard_init_name }}
    command: [ "./compose-server-init.sh" ]
    volumes:
      - {{ validator.validator_persistence_dir }}:/config
    depends_on:
      - scylla

  prometheus:
    image: prom/prometheus:latest
    container_name: {{ validator.prometheus_name }}
    volumes:
      - {{ validator.prometheus_persistence_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml
    ports:
      - "{{ validator.prometheus_port }}:9090"

  grafana:
    image: grafana/grafana:latest
    container_name: {{ validator.grafana_name }}
    environment:
      - GF_SECURITY_ADMIN_PASSWORD=admin
    ports:
      - "{{ validator.grafana_port }}:3000"
    volumes:
      - {{ validator.grafana_volume }}:/var/lib/grafana
      - {{ validator.grafana_persistence_dir }}/provisioning/dashboards:/etc/grafana/provisioning/dashboards
      - {{ validator.grafana_persistence_dir }}/dashboards:/var/lib/grafana/dashboards

  watchtower:
    image: containrrr/watchtower:latest
    container_name: {{ validator.watchtower_name }}
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
    command: [ "--interval", "30"]

volumes:
  {{ validator.scylla_volume }}:
    driver: local
  {{ validator.grafana_volume }}:
